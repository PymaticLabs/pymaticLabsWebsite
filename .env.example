# Variables de la web. Copiar a .env.local (local) o ponerlas en Vercel. Ninguna clave real en el
# repo: aqui solo los nombres y para que sirven. Lo de la entrega: docs/entrega-automatica.md.

# --- Web -------------------------------------------------------------------------------------------
# Correo del formulario de contacto (Resend) y buzon de los avisos internos si no se dice otro.
RESEND_API_KEY=
CONTACT_EMAIL=hola@pymaticlabs.com
NEXT_PUBLIC_SITE_URL=https://pymaticlabs.com

# --- Compra ----------------------------------------------------------------------------------------
# true ensena los botones de compra. Apagado hasta que el abogado revise las condiciones.
CHECKOUT_OPEN=false
# Minutos que dura un pago abierto en Stripe Checkout (minimo 30): lo que se aparta la plaza de
# lanzamiento y el hueco de la primera sesion.
CHECKOUT_MINUTES=30
# Plazas del precio de lanzamiento, en total (oferta: 10) y abiertas a la vez desde una misma IP.
LAUNCH_LIMIT=10
LAUNCH_CLIENT_LIMIT=2
# Sal de las huellas de IP y de correo (HMAC: nunca se guarda la IP ni el correo en los limites).
# Obligatoria en vivo (sin ella, la entrega no arranca): openssl rand -hex 32, una por entorno.
DELIVERY_IP_SALT=
# Limites contra el abuso (por IP, por /64 en IPv6, y por correo), en ventanas fijas. Por defecto:
# pagos abiertos por IP cada 10 min; huecos de Cal.com apartados por IP y en total mientras dura un
# pago; codigos pedidos por IP cada 15 min y por correo cada hora; codigos probados por IP y por
# correo cada 15 min (con 5 malos, ese correo espera); altas en el equipo por empresa y dia.
LIMIT_CHECKOUT_PER_IP=10
LIMIT_HOLDS_PER_IP=3
LIMIT_HOLDS_TOTAL=30
LIMIT_LOGIN_PER_IP=10
LIMIT_LOGIN_PER_EMAIL=5
LIMIT_VERIFY_PER_IP=30
LIMIT_VERIFY_PER_EMAIL=5
LIMIT_TEAM_ADDS_PER_DAY=20

# --- Entrega: modo -------------------------------------------------------------------------------
# live (por defecto): los proveedores de verdad. fake: todo falso, sin cuentas ni red (local y
# pruebas; nunca con VERCEL_ENV=production). Cada pieza se puede cambiar por separado:
#   DELIVERY_REPOSITORY=memory|supabase  DELIVERY_SIGNER=local|gcp-kms  DELIVERY_INVOICER=fake|holded
#   DELIVERY_MAILER=outbox|brevo  DELIVERY_STORAGE=local|supabase  DELIVERY_CALENDAR=fake|calcom
#   DELIVERY_AUTH=fake|supabase  DELIVERY_PAYMENTS=fake|stripe
# La firma de KMS nunca con pagos de mentira (no arranca), y las rutas de prueba (/api/dev/*) solo
# existen con todas las piezas en falso.
DELIVERY_MODE=live
# La URL publica de la web para enlaces de correos y de pago (por defecto, NEXT_PUBLIC_SITE_URL).
DELIVERY_SITE_URL=
# Modo falso: carpeta del buzon y el almacen (.delivery-fake), secreto de sus cookies y enlaces,
# clave de prueba fija para firmar (base64 de 32 bytes; si no, una nueva en cada arranque) y dias
# llenos del calendario falso.
DELIVERY_FAKE_DIR=.delivery-fake
DELIVERY_FAKE_SECRET=
DELIVERY_FAKE_SIGNING_SEED=
DELIVERY_FAKE_BUSY_DAYS=0

# --- Entrega: correos ------------------------------------------------------------------------------
# Remitente de los correos a clientes (verificado en Brevo), avisos de cada venta y alertas.
DELIVERY_FROM_EMAIL=info@pymaticlabs.com
DELIVERY_FROM_NAME=Pymatic Labs
DELIVERY_INTERNAL_EMAIL=info@pymaticlabs.com
DELIVERY_ALERT_EMAIL=info@pymaticlabs.com
# Brevo (UE), API de correo transaccional.
BREVO_API_KEY=

# --- Entrega: Stripe -------------------------------------------------------------------------------
# sk_test_... hasta abrir la venta. Precios, cupones y portal: scripts/stripe-setup.mts. Con una
# sk_live_ solo se procesan avisos en vivo (y con una de prueba, solo de prueba).
STRIPE_SECRET_KEY=
# El secreto del endpoint del webhook (whsec_...): /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Solo para scripts/stripe-setup.mts: el codigo de impuesto de Stripe Tax de los productos (por
# defecto txcd_10000000, servicios prestados por via electronica; se puede afinar en el panel).
STRIPE_TAX_CODE=

# --- Entrega: Supabase (UE, Irlanda) -------------------------------------------------------------
# Base de datos, acceso a la zona con codigo por correo y almacen privado. Settings > API Keys:
# la publica (sb_publishable_..., o la anon antigua) y la secreta (sb_secret_..., o la service_role
# antigua), esta solo en el servidor (nunca NEXT_PUBLIC_). Con la secreta nueva y "IP address
# forwarding" encendido (Auth > Rate Limits), los limites de los codigos cuentan por persona.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Entrega: licencias ------------------------------------------------------------------------------
# manual: la web no firma. Pide cada licencia a Eric por correo (con los campos), el la firma en su
# Mac con la clave que el producto ya conoce y la sube (scripts/subir-licencia.mts); la bienvenida
# sale antes, sin ella. kms: la firma la web con su clave de KMS (solo cuando el producto acepte su
# publica). Sin poner: manual en vivo salvo que KMS este puesto; en falso, la clave local de prueba.
# En Production, siempre escrita: con KMS puesto y sin ella, firmaria la web (la comprobacion lo para).
LICENSE_MODE=manual
# A quien se piden las licencias a mano (Eric), y horas sin firmar tras las que llega un aviso.
LICENSE_REQUEST_EMAIL=
LICENSE_PENDING_ALERT_HOURS=12
# La publica con la que tienen que verificar las licencias subidas. Sin poner, la del Mac de Eric
# (licencias.pub), que solo entrega pagos en vivo: en Production, sin poner. En Preview, la de una
# clave de pruebas (scripts/subir-licencia.mts --crear-clave-prueba), que solo entrega pagos de prueba.
LICENSE_MANUAL_PUBLIC_KEY=
# Solo en tu .env.local, para subir-licencia.mts --firmar-prueba: la privada de esa clave de pruebas.
LICENSE_TEST_SEED=

# --- Entrega: firma de licencias en la web (Google Cloud KMS, LICENSE_MODE=kms) --------------------
# La clave de licencias de la web (EC_SIGN_ED25519, region europea), distinta de la del Mac de Eric.
# Una clave por entorno: la de produccion solo en Production; Preview, una suya de pruebas cuya
# publica nunca va al producto:
# projects/<p>/locations/europe-west1/keyRings/<anillo>/cryptoKeys/<clave>/cryptoKeyVersions/1
GCP_KMS_KEY_VERSION=
# Sin poner: production con KMS y test con la clave local. production: la clave que conoce el
# producto, solo firma pagos de Stripe en vivo. test: una clave de KMS solo de pruebas (Preview con
# sk_test_), solo firma pagos de prueba.
LICENSE_KEY_ENV=
# Clave JSON (tal cual o en base64) de una cuenta de servicio con solo roles/cloudkms.signer y
# roles/cloudkms.publicKeyViewer sobre esa clave (nada en el proyecto). Una cuenta por entorno; la
# de produccion, marcada Sensitive y solo en Production en Vercel (las ramas de Preview no la ven).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Su publica (base64 de 32 bytes, la de /api/admin/public-key): si KMS diera otra, no se firma.
LICENSE_WEB_PUBLIC_KEY=
# true pone el pago de Stripe dentro de la licencia (campo pago). Solo cuando licencia.py lo acepte.
LICENSE_INCLUDE_PAYMENT=false
# Publicas de licencias ya anuladas (separadas por comas), para la lista de anuladas del esqueleto.
LICENSE_REVOKED_KEYS=

# --- Entrega: facturas (Holded) --------------------------------------------------------------------
HOLDED_API_KEY=
# draft (por defecto): la factura queda en borrador y el aviso interno dice que hay que emitirla
# (Verifactu) a mano. emit: se aprueba por la API, Holded la manda y se guarda para la zona.
HOLDED_INVOICE_MODE=draft
# Los ids de impuesto de la cuenta (GET /api/v2/taxes): IVA del 21 %, inversion del sujeto pasivo
# (UE), fuera de la UE y exento.
HOLDED_TAX_STANDARD=s_iva_21
HOLDED_TAX_REVERSE_CHARGE=
HOLDED_TAX_EXPORT=
HOLDED_TAX_EXEMPT=
# Series de numeracion de facturas y rectificativas (opcional; si no, la de por defecto).
HOLDED_INVOICE_SERIES_ID=
HOLDED_CREDIT_NOTE_SERIES_ID=
# negative (por defecto): las lineas de la rectificativa en negativo; positive si Holded ya resta.
HOLDED_CREDIT_NOTE_SIGN=negative
# draft (por defecto, aunque las facturas se emitan solas): la rectificativa queda en borrador y el
# aviso dice que hay que enlazarla a su factura y emitirla a mano (la API v2 no la enlaza, y
# Verifactu lo pide). emit: solo tras comprobar una de verdad.
HOLDED_CREDIT_NOTE_MODE=draft
HOLDED_API_URL=https://api.holded.com/api/v2

# --- Entrega: sesiones del Acompanado (Cal.com) ----------------------------------------------------
CALCOM_API_KEY=
# El tipo de evento de 1 hora de cada persona: {"eric": 123, "sergio": 456}
CALCOM_EVENT_TYPES=
CALCOM_API_URL=https://api.cal.com/v2

# --- Entrega: cola, descargas y llamadas internas --------------------------------------------------
# Lo mandan pg_cron (Bearer) a /api/jobs/run y /api/jobs/reconcile. Uno largo y aleatorio.
JOBS_SECRET=
# Para /api/admin/* (versiones, cola, anuladas, publica de la clave).
ADMIN_SECRET=
# Reintentos: tope de intentos, aviso tras N fallos, espera inicial y maxima (ms), bloqueo de un
# intento (s) y pasos a la vez.
JOBS_MAX_ATTEMPTS=10
JOBS_ALERT_AFTER=3
JOBS_BASE_DELAY_MS=30000
JOBS_MAX_DELAY_MS=3600000
JOBS_LOCK_SECONDS=120
JOBS_CONCURRENCY=4
# Lo que valen los enlaces de descarga (segundos) y los dias que mira la conciliacion diaria.
DOWNLOAD_URL_TTL_SECONDS=300
RECONCILE_DAYS=40

# --- Prueba de punta a punta (scripts/e2e-entrega.mts) -------------------------------------------
# Sin --start, la web que ya corre en modo falso (por defecto http://127.0.0.1:3101) y su puerto.
E2E_BASE_URL=
E2E_PORT=3101
# Sin --start, la web con LICENSE_MODE=manual para las licencias a mano (si no, se saltan) y la
# semilla de la clave de pruebas de su LICENSE_MANUAL_PUBLIC_KEY.
E2E_MANUAL_BASE_URL=
E2E_MANUAL_SEED=
